="geometry"/></mxCell><mxCell id="cancel-b1" value="&lt;b&gt;Reservation&lt;/b&gt; = Cancelled&lt;br&gt;within 24 h → refundable&lt;br&gt;&lt;b&gt;DepositRefund&lt;/b&gt; = Pending" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="162" y="543" width="176" height="104" as="geometry"/></mxCell><mxCell id="cancel-c2" value="message &quot;sẽ được hoàn lại&quot;&lt;br&gt;→ &lt;i&gt;Đóng&lt;/i&gt;&lt;br&gt;heading &quot;Đơn đặt kho đã huỷ&quot;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="362" y="93" width="176" height="104" as="geometry"/></mxCell><mxCell id="cancel-s1" value="&lt;b&gt;Reservations&lt;/b&gt; › booking row&lt;br&gt;reason (optional)&lt;br&gt;→ &lt;i&gt;Cancel booking&lt;/i&gt;&lt;br&gt;(&lt;i&gt;Mark no-show&lt;/i&gt; only after move-in)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="562" y="243" width="176" height="104" as="geometry"/></mxCell><mxCell id="cancel-b2" value="&lt;b&gt;Reservation&lt;/b&gt; = Cancelled&lt;br&gt;staff → always refundable&lt;br&gt;&lt;b&gt;DepositRefund&lt;/b&gt; = Pending" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="562" y="543" width="176" height="104" as="geometry"/></mxCell><mxCell id="cancel-s2" value="message &quot;deposit is owed back;&lt;br&gt;it now waits in Deposit Refunds&quot;&lt;br&gt;→ &lt;i&gt;Done&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="762" y="243" width="176" height="104" as="geometry"/></mxCell><mxCell id="cancel-o1" value="&lt;b&gt;Deposit Refunds&lt;/b&gt; › row&lt;br